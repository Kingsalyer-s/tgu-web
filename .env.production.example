# 生产环境变量：复制为 .env 并按需修改后再 docker compose up
# 强烈建议：JWT_SECRET 使用 openssl rand -hex 32 生成
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# 允许的前端来源（多个用逗号分隔）
CORS_ORIGIN=http://localhost

# 对外暴露的 HTTP 端口
HTTP_PORT=80

# 默认管理员（首次启动会创建；首次登录后请立即修改密码）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-strong-password
